# Все каналы алертов в одном файле (не коммитить):
#   cp infra/notifications.env.example infra/notifications.env
#   # заполните TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, SMTP_PASS
#   ./infra/demo-setup-alerts.sh
#
# Backend с Telegram:
#   TELEGRAM_ENABLED=true TELEGRAM_BOT_TOKEN=... ./infra/run-backend-demo.sh

# --- Telegram ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token...
TELEGRAM_CHAT_ID=1101310009

# --- Яндекс.Почта → ingeborg21@yandex.ru ---
# 1) id.yandex.ru → Безопасность → Пароли приложений (НЕ пароль входа!)
# 2) Почта → Настройки → Почтовые программы → IMAP + пароли приложений — ВКЛ
# 3) ВАЖНО: новый пароль приложения начинает работать через 2–3 часа (правила Яндекса)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USER=ingeborg21@yandex.ru
SMTP_PASS=your-yandex-app-password
SMTP_FROM=ingeborg21@yandex.ru
SMTP_TO=ingeborg21@yandex.ru
