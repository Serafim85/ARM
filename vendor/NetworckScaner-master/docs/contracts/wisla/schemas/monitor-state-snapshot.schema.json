{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://networkscanner.local/contracts/wisla/schemas/monitor-state-snapshot.schema.json",
  "title": "MonitorStateSnapshot",
  "description": "NS -> Wisla per-device monitoring state payload (topic wisla.monitor-state)",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "sourceSystem",
    "externalDeviceId",
    "device"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "sourceSystem": {
      "type": "string",
      "minLength": 1
    },
    "externalDeviceId": {
      "type": "integer"
    },
    "device": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "MONITOR_ON",
            "MONITOR_OFF",
            "DELETED"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ipAddress": {
          "type": "string",
          "minLength": 1
        },
        "templateIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "defaultTemplateVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "device": {
            "properties": {
              "state": {
                "const": "MONITOR_ON"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "device": {
            "required": [
              "name",
              "ipAddress",
              "templateIds",
              "defaultTemplateVersion"
            ]
          }
        }
      }
    }
  ]
}
