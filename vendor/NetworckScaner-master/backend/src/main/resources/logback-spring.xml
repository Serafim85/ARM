<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">

  <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="backend"/>

  <!-- Path/name configured via application.properties, with backward-compatible fallbacks -->
  <springProperty scope="context" name="LOG_DIR" source="app.logging.file.path" defaultValue="${app.logging.dir:./logs}"/>
  <springProperty scope="context" name="LOG_FILE" source="app.logging.file.name" defaultValue="${app.logging.file:${APP_NAME}.log}"/>

  <!-- Root level must be configurable via logging.level.root -->
  <springProperty scope="context" name="ROOT_LEVEL" source="logging.level.root" defaultValue="${app.logging.level.root:INFO}"/>

  <!-- Rolling policy knobs (defaults: daily + size, keep 14 days, 10MB chunks) -->
  <springProperty scope="context" name="MAX_HISTORY_DAYS" source="app.logging.rolling.max-history-days"
                  defaultValue="${app.logging.maxHistoryDays:14}"/>
  <springProperty scope="context" name="TOTAL_SIZE_CAP" source="app.logging.rolling.total-size-cap"
                  defaultValue="${app.logging.totalSizeCap:2GB}"/>
  <springProperty scope="context" name="MAX_FILE_SIZE" source="app.logging.rolling.max-file-size"
                  defaultValue="${app.logging.maxFileSize:10MB}"/>

  <property name="LOG_PATH" value="${LOG_DIR}/${LOG_FILE}"/>

  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} [requestId=%X{requestId:-}] - %msg%n%ex"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}</file>
    <append>true</append>
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>

    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
      <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
      <maxHistory>${MAX_HISTORY_DAYS}</maxHistory>
      <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
    </rollingPolicy>
  </appender>

  <root level="${ROOT_LEVEL}">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="ROLLING_FILE"/>
  </root>
</configuration>

